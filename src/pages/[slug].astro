---
import { render } from "astro:content";
import BookLayout from "../layouts/BookLayout.astro";
import { getTranslatedPages } from "../lib/pages";
import { titleToHtml } from "../lib/summary";
import PageFooter from "../components/PageFooter.astro";

export async function getStaticPaths() {
  const pages = await getTranslatedPages();
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page.entry!);

const heading = page.number ? `${page.number}. ${page.title}` : page.title;
---

<BookLayout title={page.title} englishSlug={page.slug} current={page.slug}>
  <main class="mx-auto max-w-3xl px-5 py-12">
    {/* data-pagefind-body scopes the search index to the page's own content:
        without it every hit would also match the 111-item sidebar. The title is
        tagged separately so results show the Farsi Summary title. */}
    <article data-pagefind-body>
      <h1
        class="text-3xl leading-snug font-bold"
        data-pagefind-meta="title"
        set:html={titleToHtml(heading)}
      />
      <div class="prose mt-8">
        <Content />
      </div>
    </article>
    <PageFooter slug={page.slug} />
  </main>
</BookLayout>
