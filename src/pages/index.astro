---
import BookLayout from "../layouts/BookLayout.astro";
import { getProgress } from "../lib/progress";
import { getBookPages } from "../lib/pages";
import { titleToHtml } from "../lib/summary";
import BuildLine from "../components/BuildLine.astro";

const { translated, total, percent } = await getProgress();
const pages = await getBookPages();

// Where to send someone who just wants to start reading: the first translated
// page in reading order, or nothing at all if the book has not been started.
const entry = pages.find((p) => p.translated);
---

<BookLayout
    title="زبان برنامه‌نویسی راست"
    description="ترجمه فارسی کتاب The Rust Programming Language"
>
    <main class="mx-auto max-w-3xl">
        <section class="hero">
            {
                /* Decorative: alt is intentionally empty so screen readers skip it.
          Add a description here if the image ever carries meaning. */
            }
            <img
                src="/toji.png"
                alt=""
                width="1024"
                height="1024"
                class="hero-img"
                fetchpriority="high"
            />
            <div class="hero-fade"></div>
            <h1 class="hero-title">زبان برنامه نویسی راست</h1>
        </section>

        <section
            class="px-5 pt-5"
            aria-label="میزان پیشرفت ترجمه"
        >
            <div class="progress-track" role="presentation">
                <div class="progress-fill" style={`width: ${percent}%`}>
                </div>
            </div>
            <BuildLine translated={translated} total={total} />
        </section>

        <div class="px-5 pt-10 pb-16">
            {
                /* Same `.prose` as a book page, and the Latin words go in code
             spans exactly as they would in the markdown — so `Rust` reads as
             the same chip here as it does in every chapter. */
            }
            <div class="prose">
                <p>
                    سلام من یزدانم، دارم سعی میکنم <code>Rust</code> یاد بگیرم و
                    شروع کردم کتاب رسمی <code>Rust</code> رو میخونم و مطالب رو به
                    زبان خودم اینجا بازگو میکنم.
                </p>
                <p>
                    توقع ترجمه خط به خط نداشته باشید و احتمال داره با توجه به
                    مسیر یادگیری خودم یه تغییراتی داخل مطالب بدم و در نهایت شما
                    دارید چیزی که یزدان نوشته رو میخونید و نه ترجمه کتاب، ولی به
                    صورت کلی مطالب اینجارو طبق کتاب رسمی <code>Rust</code> جلو
                    میبرم.
                </p>
                {
                    /* Astro drops the source whitespace either side of a line
             break that touches a tag, so any space meant to survive has to sit
             on the same line as the tag itself — hence the long line below.
             The badge gets away with it because `.nav-badge` carries its own
             `margin-inline-start`. */
                }
                <p>
                    مطالبی که کامل نشدن با تگ <span class="nav-badge" aria-hidden="true">todo!()</span><span class="sr-only">در دست نگارش</span> مشخص شدن و طبیعتا
                    نمیتونید بازشون کنید، اگه زیاد معطل شدی
                    میتونی از <a href="https://doc.rust-lang.org/book/">رفرنس انگلیسی</a> بری جلو.
                </p>
            </div>

            {
                entry && (
                    <p class="mt-8">
                        <a
                            href={`/${entry.slug}/`}
                            class="pager-link pager-next inline-block"
                        >
                            <span class="pager-bar">
                                <span class="pager-dir">start</span>
                                <span class="pager-arrow">←</span>
                            </span>
                            <span class="pager-body">
                                <span class="pager-cta">بزن بریم</span>
                                <span
                                    class="pager-title"
                                    set:html={titleToHtml(entry.title)}
                                />
                            </span>
                        </a>
                    </p>
                )
            }
        </div>
    </main>
</BookLayout>
