---
import BookLayout from "../layouts/BookLayout.astro";
import { getProgress } from "../lib/progress";
import { getBookPages } from "../lib/pages";
import { toPersianDigits } from "../lib/digits";
import { titleToHtml } from "../lib/summary";

const { translated, total, percent } = await getProgress();
const pages = await getBookPages();

// Where to send someone who just wants to start reading: the first translated
// page in reading order, or nothing at all if the book has not been started.
const entry = pages.find((p) => p.translated);
const fa = (n: number) => toPersianDigits(String(n));
---

<BookLayout
    title="زبان برنامه‌نویسی راست"
    description="ترجمه فارسی کتاب The Rust Programming Language"
>
    <main class="mx-auto max-w-3xl">
        <section class="hero">
            {
                /* Decorative: alt is intentionally empty so screen readers skip it.
          Add a description here if the image ever carries meaning. */
            }
            <img
                src="/toji.png"
                alt=""
                width="1024"
                height="1024"
                class="hero-img"
                fetchpriority="high"
            />
            <div class="hero-fade"></div>
            <h1 class="hero-title">زبان برنامه نویسی راست</h1>
        </section>

        <div class="px-5 pb-16">
            <div class="prose">
                <p>
                    سلام من یزدانم، دارم سعی میکنم Rust بگیرم ولی شروع کردم کتاب
                    رسمی Rust رو میخونم و مطالب رو به زبان خودم اینجا بازگو
                    میکنم.
                </p>
                <p>
                    توقع ترجمه خط به خط نداشته باشید و احتمال داره با توجه به
                    مسیر یادگیری خودم یه تغییراتی داخل مطالب بدم و در نهایت شما
                    دارید چیزی که یزدان نوشته رو میخونید و نه ترجمه کتاب، ولی به
                    صورت کلی مطالب اینجارو طبق کتاب رسمی Rust جلو میبرم.
                </p>
                <p>
                    مطالبی که کامل نشدن با تگ
                    <span class="nav-badge">در دست نگارش</span> مشخص شدن و طبیعتا
                    نمیتونید بازشون کنید، اگه زیاد معطل شدی میتونی از
                    <a
                        href="https://doc.rust-lang.org/book/"
                        class="underline hover:no-underline mr-1"
                        >رفرنس انگلیسی</a
                    > بری جلو.
                </p>
            </div>

            <section
                class="mt-10 border border-(--color-border) p-5"
                aria-label="میزان پیشرفت ترجمه"
            >
                <p class="text-sm">
                    تا اینجا <strong>{fa(translated)}</strong> صفحه از
                    <strong>{fa(total)}</strong> آماده شده — {fa(percent)}٪
                </p>
                <div class="progress-track mt-3" role="presentation">
                    <div class="progress-fill" style={`width: ${percent}%`}>
                    </div>
                </div>
            </section>

            {
                entry && (
                    <p class="mt-8">
                        <a
                            href={`/${entry.slug}/`}
                            class="pager-link inline-block"
                        >
                            <span class="pager-label">بزن بریم</span>
                            <span
                                class="pager-title"
                                set:html={titleToHtml(entry.title)}
                            />
                        </a>
                    </p>
                )
            }
        </div>
    </main>
</BookLayout>
