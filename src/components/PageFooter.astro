---
import { getNeighbours } from "../lib/pages";
import { titleToHtml } from "../lib/summary";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const { prev, next } = await getNeighbours(slug);

const UNTRANSLATED = "در دست نگارش";
const englishUrl = `https://doc.rust-lang.org/book/${slug}.html`;

/**
 * Neighbours are shown in strict Summary order and never skipped (ADR-0006):
 * an untranslated neighbour renders disabled, so the book's real structure stays
 * visible instead of silently teleporting the reader past missing chapters.
 */
const pager = [
  { page: prev, label: "قبلی", arrow: "→", side: "prev" },
  { page: next, label: "بعدی", arrow: "←", side: "next" },
];

/**
 * The title bar names the direction in Latin, which is unambiguous in a way an
 * arrow in an RTL layout is not. The Farsi label stays as the accessible name,
 * so a screen reader still announces قبلی/بعدی rather than "prev"/"next".
 */
---

<footer class="mt-20 pb-16 text-sm">
  <nav class="flex flex-wrap gap-4" aria-label="پیمایش صفحه‌ها">
    {
      pager.map(({ page, label, arrow, side }) => (
        <div class="min-w-0 flex-1 basis-64">
          {page ? (
            page.translated ? (
              <a href={`/${page.slug}/`} class={`pager-link pager-${side}`}>
                <span class="pager-bar">
                  <span class="pager-dir">{side}</span>
                  <span class="pager-arrow">{arrow}</span>
                </span>
                <span class="pager-body">
                  <span class="sr-only">{label}</span>
                  <span class="pager-title" set:html={titleToHtml(page.title)} />
                </span>
              </a>
            ) : (
              <span
                class={`pager-link pager-${side} pager-disabled`}
                aria-disabled="true"
                title={UNTRANSLATED}>
                <span class="pager-bar">
                  <span class="pager-dir">{side}</span>
                  <span class="pager-arrow">{arrow}</span>
                </span>
                <span class="pager-body">
                  <span class="sr-only">{label}</span>
                  {/* The title stays, per ADR-0006: the reader must see which
                      page is missing, not merely that one is. */}
                  <span class="pager-title" set:html={titleToHtml(page.title)} />
                  <span class="nav-badge" aria-hidden="true">todo!()</span>
                  <span class="sr-only">{UNTRANSLATED}</span>
                </span>
              </span>
            )
          ) : null}
        </div>
      ))
    }
  </nav>

  <div class="mt-10 space-y-2 text-xs leading-relaxed text-(--color-muted-foreground)">
    {/* Astro strips the source whitespace either side of a line break that
        touches a tag, so a space that has to survive stays on the tag's own
        line — otherwise these read as "بروکتاب" and "وApache-2.0". */}
    <p>
      کتاب اصلی، کار تیم <span class="latin">Rust</span> هست و من خودم این کتابو
      میخونم و بعد به زبان خودم برات بازگو میکنم. اگه دیدی کار لنگ
      میزنه برو <a href={englishUrl} class="underline hover:no-underline" rel="alternate" hreflang="en">کتاب اصلی رو بخون</a>
    </p>
    <p>
      متن اصلی با مجوز <span class="latin">MIT</span> و <span class="latin">Apache-2.0</span> منتشر شده
    </p>
  </div>
</footer>

<script>
  /**
   * The Pager Window advertises `[←]` and `[→]`, so they have to work — a Rust
   * developer will press the key, and a decorative binding is the one move in
   * this theme that would actually feel cheap.
   *
   * Only `<a>` is selected. An Untranslated neighbour renders as a `<span>`
   * (ADR-0006), and a first or last Page renders nothing at all, so "inert when
   * the neighbour is missing or unwritten" falls out of the existing markup
   * rather than needing a check of its own.
   */
  const prev = document.querySelector<HTMLAnchorElement>("a.pager-prev");
  const next = document.querySelector<HTMLAnchorElement>("a.pager-next");

  if (prev || next) {
    document.addEventListener("keydown", (event) => {
      // Leave every modifier combination to the browser: Alt+arrow is
      // back/forward, Shift+arrow selects text, Cmd/Ctrl+arrow jumps.
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;

      // Typing in search is the case that matters — the arrow keys are how you
      // move a caret, and stealing them would make the field unusable.
      const target = event.target;
      if (
        target instanceof HTMLElement &&
        (target.isContentEditable || target.closest("input, textarea, select"))
      ) {
        return;
      }

      // The document is RTL: ← advances, → goes back, matching the arrows the
      // windows already show.
      const destination =
        event.key === "ArrowLeft" ? next : event.key === "ArrowRight" ? prev : null;
      if (!destination) return;

      event.preventDefault();
      window.location.assign(destination.href);
    });
  }
</script>
