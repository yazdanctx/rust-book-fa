---
import { getNeighbours } from "../lib/pages";
import { titleToHtml } from "../lib/summary";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const { prev, next } = await getNeighbours(slug);

const UNTRANSLATED = "در دست نگارش";
const englishUrl = `https://doc.rust-lang.org/book/${slug}.html`;

/**
 * Neighbours are shown in strict Summary order and never skipped (ADR-0006):
 * an untranslated neighbour renders disabled, so the book's real structure stays
 * visible instead of silently teleporting the reader past missing chapters.
 */
const pager = [
  { page: prev, label: "قبلی", arrow: "→", side: "prev" },
  { page: next, label: "بعدی", arrow: "←", side: "next" },
];
---

<footer class="mt-20 pb-16 text-sm">
  <nav class="flex flex-wrap gap-4" aria-label="پیمایش صفحه‌ها">
    {
      pager.map(({ page, label, arrow, side }) => (
        <div class="min-w-0 flex-1 basis-64">
          {page ? (
            page.translated ? (
              <a href={`/${page.slug}/`} class={`pager-link pager-${side}`}>
                <span class="pager-label">
                  <span class="pager-arrow">{arrow}</span>
                  <span>{label}</span>
                </span>
                <span class="pager-title" set:html={titleToHtml(page.title)} />
              </a>
            ) : (
              <span
                class={`pager-link pager-${side} pager-disabled`}
                aria-disabled="true"
                title={UNTRANSLATED}>
                <span class="pager-label">
                  <span class="pager-arrow">{arrow}</span>
                  <span>{label}</span>
                </span>
                <span class="pager-title" set:html={titleToHtml(page.title)} />
                <span class="nav-badge">{UNTRANSLATED}</span>
              </span>
            )
          ) : null}
        </div>
      ))
    }
  </nav>

  <div class="mt-10 space-y-2 text-xs leading-relaxed text-(--color-muted-foreground)">
    {/* Astro strips the source whitespace either side of a line break that
        touches a tag, so a space that has to survive stays on the tag's own
        line — otherwise these read as "بروکتاب" and "وApache-2.0". */}
    <p>
      کتاب اصلی، کار تیم <span class="latin">Rust</span> هست و من خودم این کتابو
      میخونم و بعد به زبان خودم برات بازگو میکنم. اگه دیدی کار لنگ
      میزنه برو <a href={englishUrl} class="underline hover:no-underline" rel="alternate" hreflang="en">کتاب اصلی رو بخون</a>
    </p>
    <p>
      متن اصلی با مجوز <span class="latin">MIT</span> و <span class="latin">Apache-2.0</span> منتشر شده
    </p>
  </div>
</footer>
