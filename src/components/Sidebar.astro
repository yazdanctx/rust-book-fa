---
import { getBookTree, type BookNode } from "../lib/pages";
import { titleToHtml } from "../lib/summary";
import { toPersianDigits } from "../lib/digits";
import Search from "./Search.astro";

interface Props {
  /** Slug of the page being rendered, so the active branch can be expanded. */
  current?: string;
}

const { current } = Astro.props;
const tree = await getBookTree();

const all = tree.flatMap((n) => [n, ...n.children]);
const translated = all.filter((p) => p.translated).length;
const total = all.length;
const percent = Math.round((translated / total) * 100);

/** A chapter is open when it is the active page or contains it. */
function isOpen(node: BookNode): boolean {
  if (!current) return false;
  return node.slug === current || node.children.some((c) => c.slug === current);
}

const UNTRANSLATED = "در دست نگارش";
---

<nav id="sidebar" class="book-sidebar" aria-label="فهرست کتاب">
  <div class="border-b border-(--color-border) px-5 py-4">
    <a href="/" class="block font-bold hover:underline">زبان برنامه‌نویسی راست</a>
    <p class="mt-1 text-xs text-(--color-muted-foreground)">
      {toPersianDigits(String(translated))} از {toPersianDigits(String(total))} صفحه
      — {toPersianDigits(String(percent))}٪
    </p>
    <Search />
  </div>

  <ol class="px-3 py-4 text-sm">
    {
      tree.map((node) => (
        <li>
          {node.translated ? (
            <a
              href={`/${node.slug}/`}
              class="nav-link"
              aria-current={node.slug === current ? "page" : undefined}
            >
              {node.number && <span class="nav-number">{node.number}.</span>}
              <span set:html={titleToHtml(node.title)} />
            </a>
          ) : (
            <span class="nav-link nav-disabled" aria-disabled="true" title={UNTRANSLATED}>
              {node.number && <span class="nav-number">{node.number}.</span>}
              <span set:html={titleToHtml(node.title)} />
              <span class="nav-badge">{UNTRANSLATED}</span>
            </span>
          )}

          {node.children.length > 0 && isOpen(node) && (
            <ol class="nav-children">
              {node.children.map((child) =>
                child.translated ? (
                  <li>
                    <a
                      href={`/${child.slug}/`}
                      class="nav-link"
                      aria-current={child.slug === current ? "page" : undefined}
                    >
                      {child.number && <span class="nav-number">{child.number}</span>}
                      <span set:html={titleToHtml(child.title)} />
                    </a>
                  </li>
                ) : (
                  <li>
                    <span
                      class="nav-link nav-disabled"
                      aria-disabled="true"
                      title={UNTRANSLATED}
                    >
                      {child.number && <span class="nav-number">{child.number}</span>}
                      <span set:html={titleToHtml(child.title)} />
                      <span class="nav-badge">{UNTRANSLATED}</span>
                    </span>
                  </li>
                ),
              )}
            </ol>
          )}
        </li>
      ))
    }
  </ol>
</nav>
